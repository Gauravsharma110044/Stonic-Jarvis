{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "description": "Jarvis - a desktop messaging workspace with an AI assistant",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "electron-updater": "^6.8.11",
    "leaflet": "^1.9.4",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.stonic.jarvis",
    "productName": "Jarvis",
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.com/jarvis-updates/"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "jarvis_engine.py",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    }
  }
}
